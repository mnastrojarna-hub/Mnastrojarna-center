# --- Doručení poptávek (nastavte alespoň jedno) ---
# SMTP firemní schránky (hosting90). Poptávka přijde e-mailem → CNC Sales OS ji převezme přes IMAP automaticky.
SMTP_HOST=smtp.hosting90.cz
SMTP_PORT=465
SMTP_USER=web@mnastrojarna.cz
SMTP_PASS=
SMTP_FROM="Mnástrojárna web <web@mnastrojarna.cz>"
# Kam poptávky chodí (čárkou oddělené). Výchozí: V. Volný + J. Semorád.
LEAD_TO=vit.volny@mnastrojarna.cz,semorad@nastrojarstvi.com

# Volitelně: webhook (JSON s leadem, skóre A/B/C a údaji z ARES), např. do CNC Sales OS / CRM
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# --- Měření (spustí se až po souhlasu s cookies) ---
NEXT_PUBLIC_GA_ID=
# Ověření Google Search Console (meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=
