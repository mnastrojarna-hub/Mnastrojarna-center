# Web nemá formulář ani backend – poptávky jdou e-mailem přímo V. Volnému (src/content/site.ts).

# --- Měření (spustí se až po souhlasu s cookies) ---
NEXT_PUBLIC_GA_ID=
# Ověření Google Search Console (meta tag)
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Sdílení CAD dokumentů odkazem (volitelné) ---
# Bez nastavení je dokument vložený přímo v odkazu (bez serveru; vhodné pro parametrické díly a sestavy).
# Pro velké modely (importovaný STEP) nastavte Supabase projekt s bucketem „cad-share“
# (SQL: supabase/migrations/20261103120000_cad_share.sql v hlavním projektu). Soubory jsou šifrované, klíč je jen v odkazu.
NEXT_PUBLIC_CAD_SHARE_URL=
NEXT_PUBLIC_CAD_SHARE_KEY=
