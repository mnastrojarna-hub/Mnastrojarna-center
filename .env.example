# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Servisní (tajný) klíč — pouze server / Vercel secrets, NIKDY do gitu:
SUPABASE_SECRET_KEY=sb_secret_...

# ─── Claude / Anthropic AI ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─── E-mail: Microsoft 365 / Outlook (Graph API) ─────────────
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=

# ─── E-mail: IMAP/SMTP (hosting90 firemní schránka) ──────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase CI deploy (jen v GitHub Secrets, ne v .env) ────
# SUPABASE_ACCESS_TOKEN=sbp_...   (osobní access token z dashboardu)
# SUPABASE_DB_PASSWORD=...        (heslo k databázi)
# SUPABASE_PROJECT_ID=cqdhkzvzxdnzutizsjuz
