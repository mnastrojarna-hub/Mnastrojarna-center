# ─── Supabase ────────────────────────────────────────────────
# URL a publishable klíč jsou VEŘEJNÉ (jdou i do prohlížeče) — bezpečné.
NEXT_PUBLIC_SUPABASE_URL=https://cqdhkzvzxdnzutizsjuz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable__ysYcg4s610oBIo365YP9A_voJzEfeO
# Servisní (tajný) klíč — POUZE server / Vercel secrets, NIKDY do gitu ani do prohlížeče:
SUPABASE_SECRET_KEY=

# ─── Claude / Anthropic AI ───────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ─── E-mail: Microsoft 365 / Outlook (Graph API) ─────────────
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_TENANT_ID=
MS_GRAPH_USER=

# ─── E-mail: IMAP/SMTP (hosting90 firemní schránka) ──────────
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ─── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase CI deploy (jen v GitHub Secrets, ne v .env) ────
